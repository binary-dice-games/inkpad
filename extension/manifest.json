{
  "manifest_version": 3,
  "name": "inkpad",
  "version": "0.0.0",
  "description": "Draw on the active tab and share it live with anyone who has the link. No server, no extension needed for viewers.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "inkpad: share this tab",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "toggle-share": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Start or stop sharing the current tab"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume the share"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
